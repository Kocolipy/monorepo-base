SERVER_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TIMEOUT=15m
SESSION_COOKIE_SECURE=false
APP_USERNAME=user
APP_PASSWORD=P@ssw0rd
APP_SECONDARY_USERNAME=admin
APP_SECONDARY_PASSWORD=P@ssw0rd
APP_LOCKOUT_MAX_ATTEMPTS=3
# Seed the development Groups and Users the shipped role mapping names, so a
# local run and the e2e suite have a User per Role. Default when unset: false,
# and then startup refuses the development mapping. Never enable in a deployment.
APP_DEV_FIXTURES_ENABLED=true
# Every development fixture User's password (account-admin, auditor,
# connector-admin, monitoring, dormant). No fallback: required when the fixtures
# are on. With the fixtures on, the dormancy job also runs once at startup, after
# seeding has backdated the `dormant` fixture past the lockout window.
APP_DEV_FIXTURES_PASSWORD=Dev-Fixture-P@ssw0rd
APP_SESSION_ABSOLUTE_LIFETIME=8h
# How long recorded audit events are kept. Default when unset: 365d (one year).
# Floor: 90d — a shorter window fails startup rather than silently keeping less.
APP_AUDIT_RETENTION_PERIOD=365d
# When the retention job runs, as a Spring cron expression. Default: 0 30 3 * * *
APP_AUDIT_RETENTION_SCHEDULE="0 30 3 * * *"
# How long a User may go without logging in before the daily dormancy job locks
# it (lock cause DORMANCY; only an Admin's Unlock lifts it). Default when unset:
# 90d. Must be positive.
APP_DORMANCY_LOCKOUT_WINDOW=90d
# How long a User may go without logging in before the daily dormancy job
# removes its direct membership of every mapped Group. Default when unset: 180d.
# Must be positive and longer than the lockout window.
APP_DORMANCY_ROLE_REVOCATION_WINDOW=180d
# Logging. Unset LOG_FILE (the default) means stdout only; set it to also write a
# rolling ECS JSON file (deployed: /var/log/backend/backend.json).
# LOG_FILE=/var/log/backend/backend.json
# The deployment's name on every log record (service.environment). Default: local.
# APP_ENVIRONMENT=local
