# engines in package.json is advisory by default — npm prints a warning and
# installs anyway, which is how a Node 18 install of a Vite 7 / Vitest 4 tree
# gets far enough to fail as "test failures" instead of as a wrong Node. Make it
# a hard refusal.
engine-strict=true

# Resolve no package version published less than 7 days ago, so a freshly
# published malicious or broken release has time to be caught and pulled before
# an install can pick it up. Honoured from npm 11.10; the pinned npm 10.9.9
# ignores it with an "Unknown project config" warning until the pin moves.
min-release-age=7
